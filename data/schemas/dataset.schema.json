  "$defs": {
    "BOM": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "validation_status": {
          "default": "valid",
          "enum": [
            "valid",
            "warning"
          ],
          "title": "Validation Status",
          "type": "string"
        },
        "lineage": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Lineage",
          "type": "object"
        },
        "phase": {
          "enum": [
            "Civil works",
            "Fiber placement",
            "Activation"
          ],
          "title": "Phase",
          "type": "string"
        },
        "material_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Material Id",
          "type": "string"
        },
        "units_per_home": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Units Per Home",
          "type": "number"
        }
      },
      "required": [
        "id",
        "source_id",
        "ingested_at",
        "phase",
        "material_id",
        "units_per_home"
      ],
      "title": "BOM",
      "type": "object"
    },
